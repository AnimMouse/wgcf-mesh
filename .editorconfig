root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# shfmt reads these. tests/stub/curl has no extension, so it is listed by name.
[{*.sh,tests/stub/*}]
shell_variant = bash
switch_case_indent = true
space_redirects = true

[*.md]
trim_trailing_whitespace = false
